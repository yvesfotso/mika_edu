# Origin of the learner app on the web (apps/mobile). "Start for free" opens <url>/sign-up?lang=en|fr and
# "Sign in" opens <url>/sign-in. Leave empty to scroll to the sign-up band instead and hide "Sign in".
# `next dev` defaults to the Expo web dev server (see .env.development).
NEXT_PUBLIC_APP_URL=

# Public origin of this site, used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
